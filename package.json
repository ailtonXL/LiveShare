{
  "name": "liveforge-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Transmissão de tela peer-to-peer com WebRTC, controle de resolução, FPS e codec",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "com.ailtonxl.liveforge",
    "productName": "LiveForge Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "public/**",
      "server.js",
      "package.json"
    ],
    "win": {
      "artifactName": "LiveForge-Studio-Setup-${arch}.${ext}"
    },
    "nsis": {
      "shortcutName": "LiveForge Studio"
    }
  }
}
